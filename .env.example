# Valmont Agent — copy to .env.local. Never commit real values.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------
# Valmont only runs live. Every repository, plan, patch, validation, diff and
# pull request comes from your real GitHub account, model provider and
# workspace. There is no demo or sample-data mode: if one of these values is
# missing the affected action fails and names the variable to set.

# At least 32 random bytes. Used to encrypt server-side OAuth session data.
SESSION_SECRET=replace-with-a-long-random-value
APP_URL=http://localhost:3000

# GitHub OAuth App (callback: http://localhost:3000/api/auth/github/callback)
# Scopes: read:user user:email repo (repo covers repository creation and private repo branches/PRs)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# OpenAI-compatible model provider — keys stay on the server
MODEL_BASE_URL=https://api.openai.com/v1
MODEL_API_KEY=
MODEL_NAME=gpt-4.1-mini

# ---------------------------------------------------------------------------
# Persistence
# ---------------------------------------------------------------------------
# PostgreSQL (required for durable production task persistence)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/valmont
# Backward-compatible legacy JSON input. On first SQLite startup it is copied to
# <path>.pre-sqlite-backup and migrated without modifying this source file.
# CHAT_STORE_PATH=.data/chat-store.json
# SQLite destination. If omitted, Valmont derives a sibling .sqlite path next to
# CHAT_STORE_PATH (for example .data/chat-store.sqlite). Never set it equal to
# CHAT_STORE_PATH.
# CHAT_SQLITE_PATH=.data/chat-store.sqlite
# Used by compose.yaml for its PostgreSQL service.
POSTGRES_PASSWORD=replace-with-a-strong-database-password

# ---------------------------------------------------------------------------
# Restricted workspace settings (local adapter; use an external sandbox in production)
# ---------------------------------------------------------------------------
# Maximum time for each approved validation command.
VALMONT_COMMAND_TIMEOUT_MS=180000

# Website Studio Phase 1 uses the same SQLite file as Chat (no extra variable).
# Planned payment methods in drafts are typed future-only; no payment processing in Phase 1.
