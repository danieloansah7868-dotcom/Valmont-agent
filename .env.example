# Valmont Agent — copy to .env.local. Never commit real values.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------
# Valmont only runs live. Every repository, plan, patch, validation, diff and
# pull request comes from your real GitHub account, model provider and
# workspace. There is no demo or sample-data mode: if one of these values is
# missing the affected action fails and names the variable to set.

# At least 32 characters of random data. Used to encrypt server-side OAuth
# session data, customer sign-in cookies and the encrypted payment settings.
# The app REFUSES a short value or a known placeholder (sign-in returns 503 and
# /api/health reports SESSION_SECRET as missing) — generate one with:
#   openssl rand -base64 48
SESSION_SECRET=
# The public URL customers and merchants use to reach the app. Every link the
# server writes into an email (account verification, password reset, new-order
# notifications) and the Valmont Pay return URL is built from this value, so it
# must be the real https origin in production — not the container's bind
# address.
APP_URL=http://localhost:3000
# Set true only when the app is reachable exclusively through a proxy that
# overwrites these headers; leave false when clients can connect directly.
TRUST_PROXY=false

# GitHub OAuth App (callback: http://localhost:3000/api/auth/github/callback)
# Scopes: read:user user:email repo (repo covers repository creation and private repo branches/PRs)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# OpenAI-compatible model provider — keys stay on the server
MODEL_BASE_URL=https://api.openai.com/v1
MODEL_API_KEY=
MODEL_NAME=gpt-4.1-mini

# ---------------------------------------------------------------------------
# Persistence
# ---------------------------------------------------------------------------
# PostgreSQL (required for durable production task persistence)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/valmont
# Backward-compatible legacy JSON input. On first SQLite startup it is copied to
# <path>.pre-sqlite-backup and migrated without modifying this source file.
# CHAT_STORE_PATH=.data/chat-store.json
# SQLite destination. If omitted, Valmont derives a sibling .sqlite path next to
# CHAT_STORE_PATH (for example .data/chat-store.sqlite). Never set it equal to
# CHAT_STORE_PATH.
# CHAT_SQLITE_PATH=.data/chat-store.sqlite
# Used by compose.yaml for its PostgreSQL service.
POSTGRES_PASSWORD=replace-with-a-strong-database-password

# ---------------------------------------------------------------------------
# Restricted workspace settings
# ---------------------------------------------------------------------------
# Maximum time for each approved validation command.
VALMONT_COMMAND_TIMEOUT_MS=180000
# Where approved validation commands run.
#   * local  (default) — a restricted process on the app host, inside a
#     temporary checkout. Fine for development and single-tenant use.
#   * docker — each task gets its own throwaway container with no network,
#     dropped capabilities, and CPU/memory/pid/storage limits. Requires the
#     docker CLI and a daemon reachable from the app process (DOCKER_HOST is
#     honoured). Recommended for production; see docs/PRODUCTION.md.
# VALMONT_WORKSPACE_PROVIDER=local
# Docker provider tuning (only read when VALMONT_WORKSPACE_PROVIDER=docker;
# every value has a safe default):
# VALMONT_SANDBOX_IMAGE=valmont-sandbox:local
# VALMONT_SANDBOX_UID=1000
# VALMONT_SANDBOX_GID=1000
# VALMONT_SANDBOX_CPUS=2
# VALMONT_SANDBOX_MEMORY_BYTES=2147483648
# VALMONT_SANDBOX_PIDS_LIMIT=256
# VALMONT_SANDBOX_STORAGE_BYTES=2147483648
# VALMONT_SANDBOX_TTL_MS=3600000
# Multi-process deployments sharing one daemon: shared lease dir + stable id.
# VALMONT_SANDBOX_LEASE_DIR=
# VALMONT_SANDBOX_INSTANCE_ID=

# ---------------------------------------------------------------------------
# Website Studio Phase 1
# ---------------------------------------------------------------------------
# The Studio has no environment variable of its own.
#   * With DATABASE_URL set, drafts are stored in PostgreSQL (studio_drafts).
#   * Without it, drafts are stored in the SAME SQLite file as Chat, resolved
#     from CHAT_STORE_PATH / CHAT_SQLITE_PATH above by one shared resolver.
# Phase 1 plans a website; it does not build, deploy, or take payments.
# Payment preferences saved in a draft are future-planning notes only: mobile
# money, Paystack, Valmont Pay, cards, checkout and delivery are NOT connected.
# No card numbers, mobile-money PINs or merchant credentials are ever stored.

# ---------------------------------------------------------------------------
# Website Studio Phase 3 — payments & checkout (Valmont Pay)
# ---------------------------------------------------------------------------
# Phase 3 adds a real basket and checkout to a Studio shop. When these two
# variables are UNSET, the app runs in TEST MODE: a built-in local simulator
# stands in for the hosted payment page so the whole flow is usable with no
# external account and NO real money can move.
#
# These values provide the connection details, but they do NOT switch the app
# to Live by themselves. You must explicitly choose Live and save it on Studio
# → Settings → Payments. Until then, the local simulator remains active even
# when both values are present, so no real money can move by accident.
#   * VALMONT_PAY_API_URL — base URL of the Valmont Pay API / hosted pay pages.
#   * VALMONT_PAY_API_KEY — secret Bearer key. Never sent to the browser; the
#     public draft reader strips it before any brief reaches a client.
# VALMONT_PAY_API_URL=https://valmontpay.app
# VALMONT_PAY_API_KEY=
# VALMONT_PAY_WEBHOOK_SECRET=
#
# Every order records the payment mode it was created under (`payment_mode`:
# test or live). Test-mode orders are badged in Studio and excluded from
# revenue analytics, so a simulator payment can never be mistaken for money.
# If Live is selected but the connection is incomplete, online checkout
# methods answer 409 with a clear message instead of falling back to the
# simulator; /api/health reports `dependencies.payments = live_misconfigured`.

# ---------------------------------------------------------------------------
# Website Studio Phase 5 — payment settings page & webhook signing
# ---------------------------------------------------------------------------
# The recommended way to connect Valmont Pay is now Studio → Settings →
# Payments in the app: paste the API URL, secret key and webhook signing
# secret there. Values saved on that page are stored ENCRYPTED in the
# database, are never shown in the browser again, and win over the
# environment variables above. The environment variables remain a fallback for
# the connection values, but they never select Live by themselves.
#
#   * VALMONT_PAY_WEBHOOK_SECRET — HMAC signing secret for live payment
#     confirmations. When Live mode is on, webhooks without a valid signature
#     are REFUSED. Set it here or (better) on the Payments settings page.
# VALMONT_PAY_WEBHOOK_SECRET=
#
#   * STUDIO_PAYMENT_ADMINS — comma-separated GitHub usernames allowed to
#     change payment settings. Unset: only the product owner's account
#     ("danieloansah7868-dotcom") is a payment manager. Everyone signed in can
#     view the Payments page status.
# STUDIO_PAYMENT_ADMINS=danieloansah7868-dotcom

# ---------------------------------------------------------------------------
# Data Bundles — Stage 4 delivery engine
# ---------------------------------------------------------------------------
# Which provider sends the top-up after a bundle order is paid.
#   * unset / "simulator" — the built-in simulated provider: accepts every
#     top-up as "processing" and reports it "delivered" on the next status
#     check. No real data moves; the full owner flow (paid → top-up →
#     delivered → retry) is rehearsed locally.
#   * "techchief" — a stub until the TechChief integration document (API spec,
#     auth, pricing, callback format) lands in Stage 5: every send fails fast
#     with an owner-visible error, so selecting it early produces loud,
#     retryable failures instead of fabricated deliveries.
# Any OTHER value fails closed with the same loud failure — a typo can never
# silently activate the simulator in production.
# BUNDLE_DELIVERY_PROVIDER=

# ---------------------------------------------------------------------------
# Website Studio Phase 4 — new-order notifications (optional)
# ---------------------------------------------------------------------------
# With these unset, checkout still works. The merchant sees new orders in
# Studio; email/WhatsApp/SMS alerts are simply skipped. The same email adapter
# sends customer account verification and password-reset messages. Those
# customer-account email flows fail clearly with HTTP 503 in production until
# both variables are configured; local development shows a clearly marked,
# one-time link instead.
# RESEND_API_KEY=
# NOTIFY_EMAIL_FROM=Valmont Studio <orders@example.com>
# ARKESEL_API_KEY=
# ARKESEL_SENDER=Valmont
# TERMII_API_KEY=
# TERMII_SENDER=Valmont
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=whatsapp:+233...

# ---------------------------------------------------------------------------
# Testing (never set these in production)
# ---------------------------------------------------------------------------
# Point the PostgreSQL Studio tests at a THROWAWAY database. When it is unset
# those tests are reported as skipped, never as passed.
# STUDIO_TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/valmont_test
# Port for the Playwright end-to-end server (default 3200).
# E2E_PORT=3200
# Throwaway data directory for the end-to-end run (default .e2e-data). The real
# .data files are never opened by the tests.
# E2E_DATA_DIR=.e2e-data

# ---------------------------------------------------------------------------
# Custom domains (optional)
# ---------------------------------------------------------------------------
# Hostname merchants point their own domain at (CNAME target). Leave both unset
# until the app is deployed behind a real hostname — with them unset the
# Domain card explains that custom domains are not available yet instead of
# showing a placeholder target. NEXT_PUBLIC_STUDIO_PLATFORM_HOST is baked into
# the browser bundle at BUILD time (compose.yaml passes it as a build arg).
#
# Ownership proof: before a hostname is served, its DNS must carry BOTH
#   TXT   _valmont-verify.<hostname>   valmont-verify=<token shown in Studio>
#   CNAME <hostname>                   <STUDIO_PLATFORM_HOST>
# The token is unique per website. Active domains are re-checked in the
# background every 24 hours and revert to `pending` if either record goes.
# STUDIO_PLATFORM_HOST=sites.example.com
# NEXT_PUBLIC_STUDIO_PLATFORM_HOST=sites.example.com

# SSL Configuration Note:
# HTTPS terminates at the hosting platform / reverse proxy (e.g. Caddy, Nginx, or Vercel)
# with on-demand TLS. This app does not handle SSL certificates directly.

# ---------------------------------------------------------------------------
# Health checks
# ---------------------------------------------------------------------------
# GET /api/health            — readiness: 503 when a required setting is
#                              missing or a dependency (database, email,
#                              payments) is not usable. Route your load
#                              balancer / uptime monitor here.
# GET /api/health?probe=live — liveness: 200 whenever the process can answer.
#                              The Docker HEALTHCHECK uses this so a missing
#                              optional integration never restarts the
#                              container in a loop.
