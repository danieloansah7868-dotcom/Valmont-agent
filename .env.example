# Valmont Agent — copy to .env.local. Never commit real values.

# ---------------------------------------------------------------------------
# Runtime mode
# ---------------------------------------------------------------------------
# Live mode is the default. Leave this false for normal production use: every
# repository, plan, patch, validation, diff and pull request then comes from
# your real GitHub account, model provider and workspace.
# Set it to true ONLY to explore the interface with fictional sample data.
ENABLE_DEMO_MODE=false

# ---------------------------------------------------------------------------
# Required for live mode
# ---------------------------------------------------------------------------

# At least 32 random bytes. Used to encrypt server-side OAuth session data.
SESSION_SECRET=replace-with-a-long-random-value
APP_URL=http://localhost:3000

# GitHub OAuth App (callback: http://localhost:3000/api/auth/github/callback)
# Scopes requested: read:user user:email repo (repo is needed for private repo branches/PRs)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# OpenAI-compatible model provider — keys stay on the server
MODEL_BASE_URL=https://api.openai.com/v1
MODEL_API_KEY=
MODEL_NAME=gpt-4.1-mini

# ---------------------------------------------------------------------------
# Persistence
# ---------------------------------------------------------------------------
# PostgreSQL (required for durable production persistence)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/valmont
# Used by compose.yaml for its PostgreSQL service.
POSTGRES_PASSWORD=replace-with-a-strong-database-password

# ---------------------------------------------------------------------------
# Restricted workspace settings (local adapter; use an external sandbox in production)
# ---------------------------------------------------------------------------
# Maximum time for each approved validation command.
VALMONT_COMMAND_TIMEOUT_MS=180000
