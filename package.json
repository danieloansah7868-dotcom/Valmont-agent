{
  "name": "valmont-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A private, approval-first AI coding agent for GitHub repositories.",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke:sandbox": "tsx scripts/sandbox-smoke.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:verify": "tsx scripts/db-verify.ts",
    "db:verify:local": "tsx scripts/db-verify-local.ts",
    "validate": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.1.14",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^0.468.0",
    "next": "^16.3.1",
    "postgres": "^3.4.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tar": "^7.5.22",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "drizzle-kit": "^0.31.4",
    "eslint": "^9.17.0",
    "eslint-config-next": "^16.3.1",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22.13"
  }
}
